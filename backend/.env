# Environment Variables — AssetIQ Backend
# Copy this to .env and fill in your values

# ── App ──────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql://postgres:f%40t%40fati1971@localhost:5432/assetiq?schema=public"

# ── Redis ────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── File Storage ─────────────────────────────
STORAGE_TYPE=local
# For MinIO:
# STORAGE_TYPE=minio
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=assetiq-files

# Local storage path
UPLOAD_DIR=./uploads

# ── Email (SMTP) ──────────────────────────────
# Gmail: use App Password (2FA must be on) — https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AssetIQ System <noreply@assetiq.com>"
# Alert recipient (Supervisor/Admin email)
ALERT_EMAIL=supervisor@hospital.com

# ── Frontend URL (CORS) ───────────────────────
FRONTEND_URL=http://localhost:3002

# ── Company ──────────────────────────────────
COMPANY_NAME="Hospital Asset Management"
CURRENCY=BDT
FISCAL_YEAR_START_MONTH=7
